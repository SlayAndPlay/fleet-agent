Vagrant.configure("2") do |c|
  c.vm.box = "almalinux/9"
  c.vm.synced_folder ".", "/vagrant", disabled: true
  { "dns01" => "192.168.56.10",
    "ntp01" => "192.168.56.11",
    "nfs01" => "192.168.56.12",
    "app01" => "192.168.56.21" }.each do |name, ip|
    c.vm.define name do |n|
      n.vm.hostname = name
      n.vm.network "private_network", ip: ip
      n.vm.provider :libvirt do |lv|
        lv.memory = 1024
        lv.cpus = 1
        lv.storage :file, size: "10G" if name == "nfs01"
      end
    end
  end
end
