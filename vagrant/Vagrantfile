Vagrant.configure("2") do |c|
  c.vm.box = "almalinux/9"
  c.vm.synced_folder ".", "/vagrant", disabled: true
  { "dns01" => "192.168.56.10",
    "ntp01" => "192.168.56.11",
    "app01" => "192.168.56.21" }.each do |name, ip|
    c.vm.define name do |n|
      n.vm.hostname = name
      n.vm.network "private_network", ip: ip
      n.vm.provider :libvirt do |l|
        l.memory = 1024
        l.cpus = 1
      end
    end
  end
end
